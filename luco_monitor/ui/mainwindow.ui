  <property name="styleSheet">
   <string notr="true">QWidget { font-size: 12px; }
QMainWindow, QWidget#centralwidget, QWidget#statusPanel, QWidget#canTab, QWidget#dxlTab, QStatusBar { background-color: #efefef; color: #1a1a1a; }
QLabel, QCheckBox, QGroupBox { color: #1a1a1a; }
QGroupBox { font-weight: bold; color: #1a1a1a; border: 1px solid #8a8a8a; margin-top: 9px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; left: 6px; padding: 0 3px; font-family: "DejaVu Sans Mono", monospace; }
QLabel[role="video"] { background-color: #000000; color: #8c8c8c; border: 1px solid #4a4a4a; font-family: "DejaVu Sans Mono", monospace; font-size: 12px; }
QLabel[role="caption"] { color: #505050; font-size: 11px; font-family: "DejaVu Sans Mono", monospace; }
QLabel[role="field"] { background-color: #ffffff; color: #1a1a1a; border: 1px solid #8a8a8a; padding: 1px 6px; font-family: "DejaVu Sans Mono", monospace; font-weight: bold; }
QLabel[role="stateBig"] { color: #1a1a1a; font-family: "DejaVu Sans Mono", monospace; font-size: 17px; font-weight: bold; }
QLabel[state] { border: 1px solid #5a5a5a; padding: 3px 4px; font-family: "DejaVu Sans Mono", monospace; font-weight: bold; font-size: 11px; }
QLabel[state="off"]   { background-color: #e4e4e4; color: #8c8c8c; border-color: #a8a8a8; }
QLabel[state="ok"]    { background-color: #ffffff; color: #1a1a1a; }
QLabel[state="warn"]  { background-color: #b8b8b8; color: #000000; border: 2px solid #1a1a1a; }
QLabel[state="error"] { background-color: #1a1a1a; color: #ffffff; }
QLabel[role="key"] { background-color: #f6f6f6; color: #1a1a1a; border: 1px solid #5a5a5a; font-family: "DejaVu Sans Mono", monospace; font-weight: bold; }
QLabel[role="key"][active="true"] { background-color: #1e1e1e; color: #ffffff; }
QTableWidget { background-color: #ffffff; color: #1a1a1a; font-family: "DejaVu Sans Mono", monospace; font-size: 11px; gridline-color: #b4b4b4; }
QHeaderView::section { background-color: #e6e6e6; color: #1a1a1a; border: 1px solid #b4b4b4; font-family: "DejaVu Sans Mono", monospace; font-size: 11px; padding: 2px 4px; }
QListWidget { background-color: #ffffff; color: #1a1a1a; font-family: "DejaVu Sans Mono", monospace; font-size: 11px; }
QPlainTextEdit#eventLog { background-color: #0e0e0e; color: #c8c8c8; border: 1px solid #4a4a4a; font-family: "DejaVu Sans Mono", monospace; font-size: 11px; }
QPushButton { background-color: #e6e6e6; color: #1a1a1a; border: 1px solid #8a8a8a; font-family: "DejaVu Sans Mono", monospace; font-weight: bold; padding: 5px 8px; }
QPushButton#stopButton { background-color: #1a1a1a; color: #ffffff; border: 1px solid #000000; }
QListWidget::item:selected { background-color: #3a3a3a; color: #ffffff; }
QProgressBar { border: 1px solid #8a8a8a; background-color: #ffffff; color: #1a1a1a; text-align: center; font-family: "DejaVu Sans Mono", monospace; font-size: 11px; }
QProgressBar::chunk { background-color: #7a7a7a; }
QPushButton:hover { background-color: #d8d8d8; }
QPushButton:pressed { background-color: #c4c4c4; }
QPushButton#stopButton:hover { background-color: #333333; }
QTabWidget::pane { border: 1px solid #8a8a8a; background-color: #efefef; }
QTabBar::tab { background-color: #dcdcdc; color: #1a1a1a; border: 1px solid #8a8a8a; padding: 4px 10px; font-family: "DejaVu Sans Mono", monospace; }
QTabBar::tab:selected { background-color: #efefef; font-weight: bold; border-bottom-color: #efefef; }
QDoubleSpinBox { background-color: #ffffff; color: #1a1a1a; border: 1px solid #8a8a8a; padding: 2px 4px; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid #5a5a5a; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #1a1a1a; }
QToolTip { background-color: #ffffe1; color: #1a1a1a; border: 1px solid #5a5a5a; }</string>
